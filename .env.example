# Kopiraj u .env.local za rad na računaru, a na Vercelu upiši iste vrednosti
# u Settings → Environment Variables.
# Vrednosti nađeš u Supabase → Project Settings → API (ili „Connect").

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# „anon public" ključ ili novi „publishable" ključ (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
